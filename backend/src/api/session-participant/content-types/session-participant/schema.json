{
  "kind": "collectionType",
  "collectionName": "session_participants",
  "info": {
    "singularName": "session-participant",
    "pluralName": "session-participants",
    "displayName": "Session Participant",
    "description": "Links a participant to a session with a role, so one participant can appear in many sessions with different roles"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "participant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::participant.participant",
      "inversedBy": "appearances"
    },
    "role": {
      "type": "enumeration",
      "enum": [
        "speaker",
        "panelist",
        "facilitator",
        "host",
        "presenter",
        "session_chair"
      ],
      "required": true
    },
    "displayOrder": {
      "type": "integer",
      "default": 0
    },
    "session": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::session.session",
      "inversedBy": "participants"
    }
  }
}
